# Copy to .env and adjust. Never commit the real .env file.
APP_ENV=development
SERVER_PORT=8080

# PostgreSQL connection string.
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk?sslmode=disable

# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-value

# Go duration strings.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
